<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows7.0</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>bds-manager.ico</ApplicationIcon>
		<Platforms>AnyCPU</Platforms>
		
		<!-- Assembly & Release Information -->
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<Version>1.0.0</Version>
		<Title>BDSUtil</Title>
		<Product>BDSUtil Core</Product>
		<Company>SecuroWolf</Company>
		<Copyright>Copyright © 2026 David Horne / SecuroWolf</Copyright>
		<Description>Bedrock Dedicated Server Utility and Management Wrapper.</Description>

		<!-- Framework-Dependent Single-File Release Settings -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>false</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

		<!-- Silences warnings -->
		<GenerateResourceWarnOnBinaryFormatterUse>false</GenerateResourceWarnOnBinaryFormatterUse>
		<NoWarn>$(NoWarn);NU1701</NoWarn>
		<Version>$(VersionPrefix)</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Open.NAT" Version="2.1.0" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="ReaLTaiizor">
			<HintPath>Resources\Dependencies\ReaLTaiizor.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\Dependencies\ReaLTaiizor.dll" />
		<EmbeddedResource Include="Resources\CommentStrippedServer.Properties.ini" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Settings.Designer.cs">
	    <DesignTimeSharedInput>True</DesignTimeSharedInput>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Settings.settings</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Properties\Settings.settings">
	    <Generator>SettingsSingleFileGenerator</Generator>
	    <LastGenOutput>Settings.Designer.cs</LastGenOutput>
	  </None>
	</ItemGroup>
</Project>