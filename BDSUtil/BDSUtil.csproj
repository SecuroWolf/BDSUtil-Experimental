<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net11.0-windows7.0</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>bds-manager.ico</ApplicationIcon>
		<Platforms>AnyCPU</Platforms>
		
		<!-- Assembly & Release Information -->
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
		<Version>2.0.0</Version>
		<Title>BDSUtil</Title>
		<Product>BDSUtil Core</Product>
		<Company>SecuroWolf</Company>
		<Copyright>Copyright © 2026 David Horne / SecuroWolf</Copyright>
		<Description>Bedrock Dedicated Server Utility and Management Wrapper.</Description>

		<!-- Framework-Dependent Single-File Release Settings -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>false</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

		<!-- Silences warnings -->
		<GenerateResourceWarnOnBinaryFormatterUse>false</GenerateResourceWarnOnBinaryFormatterUse>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\Documents\material3-dotnet-main\material3-dotnet-main\src\Material3.Core\Material3.Core.csproj">
			<Private>false</Private>
		</ProjectReference>
		<ProjectReference Include="..\..\..\Documents\material3-dotnet-main\material3-dotnet-main\src\Material3.WinForms\Material3.WinForms.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\CommentStrippedServer.Properties.ini" />
	</ItemGroup>

	<Target Name="EmbedMaterial3Dependencies" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
		<ItemGroup>
			<_Material3Assemblies Include="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == 'Material3.Core' Or '%(ReferencePath.Filename)' == 'Material3.WinForms'" />
			<EmbeddedResource Include="@(_Material3Assemblies)">
				<LogicalName>BDSUtil.Resources.Dependencies.%(Filename)%(Extension)</LogicalName>
			</EmbeddedResource>
		</ItemGroup>
	</Target>

	<ItemGroup>
	  <Compile Update="MainWindow.RemoteApi.cs">
	    <SubType>Code</SubType>
	  </Compile>
	  <Compile Update="Properties\Settings.Designer.cs">
	    <DesignTimeSharedInput>True</DesignTimeSharedInput>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Settings.settings</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Properties\Settings.settings">
	    <Generator>SettingsSingleFileGenerator</Generator>
	    <LastGenOutput>Settings.Designer.cs</LastGenOutput>
	  </None>
	</ItemGroup>
</Project>