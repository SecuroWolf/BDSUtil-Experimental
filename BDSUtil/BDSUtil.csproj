<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>bds-manager.ico</ApplicationIcon>
    <Platforms>AnyCPU</Platforms>
    
    <!-- Silences the MSB3825 ImageList BinaryFormatter warnings -->
    <GenerateResourceWarnOnBinaryFormatterUse>false</GenerateResourceWarnOnBinaryFormatterUse>
	<NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Open.NAT" Version="2.1.0"/>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="ReaLTaiizor">
			<HintPath>Resources\Dependencies\ReaLTaiizor.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\Dependencies\ReaLTaiizor.dll" />
		<EmbeddedResource Include="Resources\CommentStrippedServer.Properties.ini" />
	</ItemGroup>
</Project>