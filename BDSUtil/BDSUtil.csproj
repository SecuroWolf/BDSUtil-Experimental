<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>bds-manager.ico</ApplicationIcon>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Your Local UI Library -->
    <Reference Include="ReaLTaiizor">
      <HintPath>Resources\Dependencies\ReaLTaiizor.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Preserve your custom embedded files (Forms/RESX are handled automatically) -->
    <EmbeddedResource Include="Resources\Dependencies\Open.Nat.dll" />
    <EmbeddedResource Include="Resources\Dependencies\ReaLTaiizor.dll" />
    <EmbeddedResource Include="Resources\CommentStrippedServer.Properties.ini" />
  </ItemGroup>

</Project>